# Go API and local development environment.
# The Python API loads nlp/.env explicitly; copy its settings there or provide
# them in the process environment when running the Python service.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides for Python user-token verification.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
# Required for Python internal service-token routes; keep server-side only.
INTERNAL_SERVICE_SECRET=
INTERNAL_SERVICE_ISSUER=
INTERNAL_SERVICE_AUDIENCE=

REDIS_ADDR=
REDIS_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=
PORT=8080

# NLP worker and services
REDIS_URL=
GROQ_API_KEY=
GITHUB_API_TOKEN=
