{
  "version": 2,
  "description": "Chunk-level lexical benchmark over the synthetic mini repository. Ground truth identifies exact file and line ranges; other indexed chunks are ranking distractors. Terms are explicit lexical signals, not natural-language understanding.",
  "default_scope": {
    "company_id": "company-a",
    "repository_id": "mini-repo-a",
    "snapshot_id": "mini-repo-a@fixture-v1",
    "source_revision": "fixture-v1"
  },
  "chunking": {
    "chunker_version": "benchmark-line-window-v1",
    "max_lines": 5,
    "overlap_lines": 1,
    "max_chunk_bytes": 1200
  },
  "queries": [
    {
      "id": "chunk-function-01",
      "terms": [
        "register_routes"
      ],
      "expected_chunks": [
        {
          "file_path": "src/api/routes.py",
          "start_line": 5,
          "end_line": 8
        }
      ]
    },
    {
      "id": "chunk-call-01",
      "terms": [
        "should_retry"
      ],
      "expected_chunks": [
        {
          "file_path": "src/payments/service.py",
          "start_line": 13,
          "end_line": 17
        },
        {
          "file_path": "src/payments/retry.py",
          "start_line": 5,
          "end_line": 8
        }
      ]
    },
    {
      "id": "chunk-call-02",
      "terms": [
        "record_payment"
      ],
      "expected_chunks": [
        {
          "file_path": "src/payments/service.py",
          "start_line": 17,
          "end_line": 21
        },
        {
          "file_path": "src/storage/ledger.py",
          "start_line": 5,
          "end_line": 9
        }
      ]
    },
    {
      "id": "chunk-condition-01",
      "terms": [
        "temporary_error"
      ],
      "expected_chunks": [
        {
          "file_path": "src/payments/service.py",
          "start_line": 13,
          "end_line": 17
        }
      ]
    },
    {
      "id": "chunk-storage-01",
      "terms": [
        "_insert"
      ],
      "expected_chunks": [
        {
          "file_path": "src/storage/ledger.py",
          "start_line": 5,
          "end_line": 9
        },
        {
          "file_path": "src/storage/ledger.py",
          "start_line": 9,
          "end_line": 12
        }
      ]
    },
    {
      "id": "chunk-empty-01",
      "terms": [
        "KubernetesDeployment"
      ],
      "expected_chunks": []
    }
  ]
}
