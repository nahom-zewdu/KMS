{
  "version": 1,
  "description": "Shared identifier benchmark for comparing symbol and source-chunk lexical retrieval at file level. Each question asks for the file containing a declaration; source candidates are deduplicated by file before ranking. This does not compare symbol-vs-chunk passage quality or natural-language understanding.",
  "default_scope": {
    "company_id": "company-a",
    "repository_id": "mini-repo-a",
    "snapshot_id": "mini-repo-a@fixture-v1",
    "source_revision": "fixture-v1"
  },
  "queries": [
    {
      "id": "definition-register-routes",
      "question": "Which file defines register_routes?",
      "identifier": "register_routes",
      "expected_paths": [
        "src/api/routes.py"
      ]
    },
    {
      "id": "definition-should-retry",
      "question": "Which file defines should_retry?",
      "identifier": "should_retry",
      "expected_paths": [
        "src/payments/retry.py"
      ]
    },
    {
      "id": "definition-record-payment",
      "question": "Which file defines record_payment?",
      "identifier": "record_payment",
      "expected_paths": [
        "src/storage/ledger.py"
      ]
    },
    {
      "id": "definition-private-insert",
      "question": "Which file defines _insert?",
      "identifier": "_insert",
      "expected_paths": [
        "src/storage/ledger.py"
      ]
    }
  ]
}
