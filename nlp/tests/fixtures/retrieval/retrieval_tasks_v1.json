{
  "version": 1,
  "name": "krt03-retrieval-task-benchmark",
  "description": "Thirty task-labeled positive queries (10 each for declaration discovery, call-site/context discovery, and passage retrieval) plus three explicit no-evidence queries over a synthetic multi-module Python repository.",
  "corpus": {
    "root": "mini_repo_v2",
    "language": "python",
    "file_count": 9,
    "company_id": "benchmark-company",
    "repository_id": "benchmark-repository",
    "snapshot_id": "benchmark-snapshot-v1",
    "source_revision": "benchmark-revision-v1"
  },
  "label_schema": {
    "declaration_discovery": "expected_symbols lists declaration names; expected_paths lists files containing those declarations. Score symbol retrieval by symbol identity where available and file-level retrieval separately.",
    "call_site_context": "expected_ranges lists exact source ranges containing the call/use/context, not the callee declaration. Score chunk retrieval by range overlap and report file-level discovery separately.",
    "passage_retrieval": "expected_ranges lists exact answer-bearing source ranges. Score exact/overlap relevance at chunk level; multiple ranges may be relevant.",
    "range_convention": "One-based inclusive line ranges. A retrieved chunk is relevant when its range overlaps a labeled range in the same file. Preserve exact-match rate as a diagnostic; do not silently treat all chunks in a relevant file as relevant."
  },
